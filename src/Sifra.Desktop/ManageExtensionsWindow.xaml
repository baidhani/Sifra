<ui:FluentWindow x:Class="Sifra.Desktop.ManageExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Manage Extensions" Height="520" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        Background="{DynamicResource Sifra.WindowBrush}">
    <Grid Background="{DynamicResource Sifra.WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Manage Extensions" Background="{DynamicResource Sifra.WindowBrush}"
                     ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <ui:TextBlock Text="Browsers that can access this vault through the Sifra extension."
                              FontTypography="Caption" Foreground="{DynamicResource Sifra.TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <ui:TextBlock Text="Active" FontTypography="BodyStrong" Margin="0,0,0,10"/>
                <ui:TextBlock x:Name="NoActiveText" Text="No paired browser extensions yet."
                              FontTypography="Caption" Foreground="{DynamicResource Sifra.TextSecondaryBrush}" Margin="0,0,0,10"/>
                <ItemsControl x:Name="ActiveDevicesList" Margin="0,0,0,20"/>

                <ui:TextBlock Text="Revoked" FontTypography="BodyStrong" Margin="0,0,0,10"/>
                <ui:TextBlock x:Name="NoRevokedText" Text="No revoked browser extensions."
                              FontTypography="Caption" Foreground="{DynamicResource Sifra.TextSecondaryBrush}" Margin="0,0,0,10"/>
                <ItemsControl x:Name="RevokedDevicesList"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <ui:Button Content="Close" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

<Application x:Class="Sifra.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sifra.Desktop"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Assets/Sifra.Brand.xaml"/>
                <ResourceDictionary Source="Assets/Sifra.Tokens.xaml"/>
                <ResourceDictionary Source="Assets/Sifra.Icons.xaml"/>
                <ResourceDictionary Source="Assets/Sifra.Shell.xaml"/>
                <ResourceDictionary Source="Assets/Sifra.Theme.Light.xaml"/>
                <ResourceDictionary Source="Assets/Sifra.WpfUiBridge.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

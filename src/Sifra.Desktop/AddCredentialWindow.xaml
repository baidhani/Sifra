<ui:FluentWindow x:Class="Sifra.Desktop.AddCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Sifra.Desktop"
        mc:Ignorable="d"
        Title="Add Credential" Height="760" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        Background="{DynamicResource Sifra.WindowBrush}">
    <ui:FluentWindow.Resources>
        <!-- A plain RadioButton restyled as a horizontal tab: no visible
             "radio dot", just the label with an accent underline when
             checked — a lighter-weight look than pulling in and re-theming
             WPF's own TabControl for just four tabs. -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="0,0,0,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Sifra.Brand.PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource Sifra.WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                     Background="{DynamicResource Sifra.WindowBrush}" ShowMaximize="False" ShowMinimize="False"/>

        <!-- Card panel flush to the left/right window edges (no side margin);
             only the bottom keeps space to breathe before the button row. -->
        <Border Grid.Row="1" Margin="0,0,0,20" Background="{DynamicResource Sifra.CardBrush}"
                BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="0,1,0,1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:TextBlock Text="Title" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="LabelBox" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock x:Name="TagsSummaryText" Grid.Column="0" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Sifra.TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                    <ui:Button Grid.Column="1" Content="Set tags" Icon="{ui:SymbolIcon Tag24}" Click="OnSetTagsClick"/>
                </Grid>

                <CheckBox x:Name="FavoriteCheckBox" Content="Mark as favorite"
                          Foreground="{DynamicResource Sifra.TextPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="FieldsTabButton" Style="{StaticResource TabButton}" GroupName="AddCredentialTab"
                             Content="Fields" Margin="0,0,24,0" Checked="OnTabChanged"
                             Foreground="{DynamicResource Sifra.TextPrimaryBrush}"/>
                <RadioButton x:Name="NotesTabButton" Style="{StaticResource TabButton}" GroupName="AddCredentialTab"
                             Content="Notes" Margin="0,0,24,0" Checked="OnTabChanged"
                             Foreground="{DynamicResource Sifra.TextPrimaryBrush}"/>
                <RadioButton x:Name="ImagesTabButton" Style="{StaticResource TabButton}" GroupName="AddCredentialTab"
                             Content="Images" Margin="0,0,24,0" Checked="OnTabChanged"
                             Foreground="{DynamicResource Sifra.TextPrimaryBrush}"/>
                <RadioButton x:Name="FilesTabButton" Style="{StaticResource TabButton}" GroupName="AddCredentialTab"
                             Content="Files" Checked="OnTabChanged"
                             Foreground="{DynamicResource Sifra.TextPrimaryBrush}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Fully dynamic field list — every field (login,
                         password, website, or anything else) is just an
                         entry here, freely added and removed. A new
                         credential starts with three common defaults
                         (Login/Password/Website) purely as a convenience seed. -->
                    <StackPanel x:Name="FieldsTabPanel" Margin="0,0,16,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="Fields" FontTypography="BodyStrong" VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="1" Content="Add another field" Icon="{ui:SymbolIcon Add24}" Click="OnAddFieldClick"/>
                        </Grid>

                        <ItemsControl x:Name="FieldsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CustomFieldRowViewModel}">
                                    <Border BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Margin="0,0,8,0"
                                                            PlaceholderText="Field name"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{x:Static local:CustomFieldTypeDisplay.Options}"
                                                          DisplayMemberPath="DisplayName" SelectedValuePath="Type"
                                                          SelectedValue="{Binding Type, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" Click="OnRemoveFieldClick" Tag="{Binding}"
                                                           ToolTip="Remove this field"/>
                                            </Grid>
                                            <ui:TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="Field value"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Notes: a single dedicated free-text field, separate
                         from the Fields list — stored under the hood as a
                         field named "Notes", but the Add/Edit UI treats it
                         as its own tab rather than one more Fields row. -->
                    <StackPanel x:Name="NotesTabPanel" Margin="0,0,16,0" Visibility="Collapsed">
                        <ui:TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                                    Height="300" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                    PlaceholderText="Notes"/>
                    </StackPanel>

                    <!-- Images: only meaningful once the credential has an id
                         (i.e. it's been saved at least once) — a brand-new,
                         unsaved credential shows a hint instead. -->
                    <StackPanel x:Name="ImagesTabPanel" Margin="0,0,16,0" Visibility="Collapsed">
                        <ui:TextBlock x:Name="ImagesUnsavedHint" Text="Save the credential first, then reopen it to add images."
                                      FontTypography="Body" Foreground="{DynamicResource Sifra.TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="ImagesReadyPanel">
                            <ui:Button Content="Add image" Icon="{ui:SymbolIcon Image24}" Click="OnAddImageClick"
                                       HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="ImagesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Files: same "needs a saved credential" constraint as Images. -->
                    <StackPanel x:Name="FilesTabPanel" Margin="0,0,16,0" Visibility="Collapsed">
                        <ui:TextBlock x:Name="FilesUnsavedHint" Text="Save the credential first, then reopen it to add files."
                                      FontTypography="Body" Foreground="{DynamicResource Sifra.TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="FilesReadyPanel">
                            <ui:Button Content="Add file" Icon="{ui:SymbolIcon DocumentAdd24}" Click="OnAddFileClick"
                                       HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="FilesList"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <ui:Button Content="Cancel" Margin="0,0,10,0" Click="OnCancelClick"/>
            <ui:Button x:Name="SaveButton" AutomationProperties.AutomationId="SaveCredentialButton" Content="Save" Appearance="Primary" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

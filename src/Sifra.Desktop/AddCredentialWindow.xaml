<ui:FluentWindow x:Class="Sifra.Desktop.AddCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Sifra.Desktop"
        mc:Ignorable="d"
        Title="Add Credential" Height="720" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        Background="{DynamicResource Sifra.WindowBrush}">
    <Grid Background="{DynamicResource Sifra.WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                     Background="{DynamicResource Sifra.WindowBrush}" ShowMaximize="False" ShowMinimize="False"/>

        <!-- Card panel flush to the left/right window edges (no side margin);
             only the bottom keeps space to breathe before the button row. -->
        <Border Grid.Row="1" Margin="0,0,0,20" Background="{DynamicResource Sifra.CardBrush}"
                BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="0,1,0,1">
        <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">
                <ui:TextBlock Text="Label" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="LabelBox" Margin="0,0,0,16"/>

                <ui:TextBlock Text="Username" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,16"/>

                <ui:TextBlock Text="Password" FontTypography="BodyStrong" Margin="0,0,0,6"/>

                <!-- Add mode: shown in plain text while typing, no masking -->
                <ui:TextBox x:Name="NewPasswordBox" Margin="0,0,0,4"/>
                <ui:TextBlock x:Name="NewPasswordHint" Text="Shown in plain text so you can confirm what you typed."
                              FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                <!-- Edit mode: masked with the built-in reveal toggle -->
                <ui:PasswordBox x:Name="ExistingPasswordBox" AutomationProperties.AutomationId="AddCredentialPasswordBox"
                                PasswordChar="&#9679;" Visibility="Collapsed" Margin="0,0,0,16"/>

                <ui:TextBlock Text="URL" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="UrlBox" Margin="0,0,0,16"/>

                <ui:TextBlock Text="Phone" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="PhoneBox" Margin="0,0,0,16"/>

                <ui:TextBlock Text="Account number" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="AccountNumberBox" Margin="0,0,0,16"/>

                <ui:TextBlock Text="PIN" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="NewPinBox" Margin="0,0,0,4"/>
                <ui:TextBlock x:Name="NewPinHint" Text="Shown in plain text so you can confirm what you typed."
                              FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>
                <ui:PasswordBox x:Name="ExistingPinBox" PasswordChar="&#9679;" Visibility="Collapsed" Margin="0,0,0,16"/>

                <ui:TextBlock Text="Notes" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                <ui:TextBlock Text="Labels (comma-separated)" FontTypography="BodyStrong" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="LabelsBox" Margin="0,0,0,16"/>

                <CheckBox x:Name="FavoriteCheckBox" Content="Mark as favorite" Margin="0,0,0,20"
                          Foreground="{DynamicResource Sifra.TextPrimaryBrush}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" Text="Custom fields" FontTypography="BodyStrong" VerticalAlignment="Center"/>
                    <ui:Button Grid.Column="1" Content="Add Field" Icon="{ui:SymbolIcon Add24}" Click="OnAddCustomFieldClick"/>
                </Grid>

                <ItemsControl x:Name="CustomFieldsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CustomFieldRowViewModel}">
                            <Border BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Margin="0,0,8,0"
                                                    PlaceholderText="Field name"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static local:CustomFieldTypeDisplay.Options}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Type"
                                                  SelectedValue="{Binding Type, Mode=TwoWay}" Margin="0,0,8,0"/>
                                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" Click="OnRemoveCustomFieldClick" Tag="{Binding}"/>
                                    </Grid>
                                    <ui:TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="Field value"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <ui:Button Content="Cancel" Margin="0,0,10,0" Click="OnCancelClick"/>
            <ui:Button x:Name="SaveButton" AutomationProperties.AutomationId="SaveCredentialButton" Content="Save" Appearance="Primary" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

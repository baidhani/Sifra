<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!--
    WPF-UI's own controls (ui:Card, ui:TextBox, ui:PasswordBox, ui:Button)
    carry their own theme resource keys, independent of Sifra.Theme.*.xaml
    — merging ui:ThemesDictionary Theme="Light" once at startup means those
    controls stay light-styled forever unless something overrides their
    specific keys. This dictionary redefines exactly those keys (verified
    against the installed Wpf.Ui.dll, not guessed) to redirect to our own
    theme-reactive Sifra.Theme.* colors via DynamicResource, so every ui:
    control automatically follows whichever Sifra theme is active with no
    changes needed in the XAML files that use them.

    Must be merged AFTER ui:ThemesDictionary/ui:ControlsDictionary so these
    definitions win. Never swapped by ThemeManager (only the
    Sifra.Theme.Light/Dark.xaml entry is) — this dictionary is permanent;
    it just keeps pointing at whichever theme colors are currently loaded.

    Accent-appearance buttons (ui:Button Appearance="Primary") are
    deliberately NOT touched here: they use AccentButtonBackground/
    Foreground, which is already Sifra's brand blue in both themes per the
    package's own rule that brand colors don't change with theme.
  -->

  <!-- ui:Card -->
  <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource Sifra.Theme.Card}"/>
  <SolidColorBrush x:Key="CardForeground" Color="{DynamicResource Sifra.Theme.TextPrimary}"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource Sifra.Theme.Border}"/>
  <SolidColorBrush x:Key="CardFooterBackground" Color="{DynamicResource Sifra.Theme.Card}"/>

  <!-- ui:TextBox and ui:PasswordBox share these TextControl* keys -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource Sifra.Theme.Input}"/>
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource Sifra.Theme.Input}"/>
  <!-- A subtle lift off the base Input color, not the much brighter nav-item
       Hover brush — that read as an inconsistent "different field" highlight
       rather than ordinary pointer-over feedback. -->
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource Sifra.Theme.Card}"/>
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{DynamicResource Sifra.Theme.Hover}"/>
  <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource Sifra.Theme.TextPrimary}"/>
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource Sifra.Theme.TextSecondary}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource Sifra.Theme.TextSecondary}"/>
  <SolidColorBrush x:Key="TextControlButtonForeground" Color="{DynamicResource Sifra.Theme.TextSecondary}"/>
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{DynamicResource Sifra.Theme.Border}"/>
  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{DynamicResource Sifra.Theme.Border}"/>
  <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{DynamicResource Sifra.Brand.Primary}"/>

  <!-- Text selection highlight (native TextBox/PasswordBox property, not a
       theme resource key) defaults to the Windows system accent color, which
       shows up as a jarring bright-blue patch over our dark input fields
       whenever a field's text is selected (e.g. auto-selected on focus). -->
  <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
    <Setter Property="SelectionBrush" Value="{DynamicResource Sifra.Brand.PrimaryBrush}"/>
    <Setter Property="SelectionTextBrush" Value="{DynamicResource Sifra.SelectedTextBrush}"/>
  </Style>
  <Style TargetType="{x:Type ui:PasswordBox}" BasedOn="{StaticResource {x:Type ui:PasswordBox}}">
    <Setter Property="SelectionBrush" Value="{DynamicResource Sifra.Brand.PrimaryBrush}"/>
    <Setter Property="SelectionTextBrush" Value="{DynamicResource Sifra.SelectedTextBrush}"/>
  </Style>

  <!-- ui:Button, default (non-Accent) appearance -->
  <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource Sifra.Theme.Card}"/>
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource Sifra.Theme.Hover}"/>
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource Sifra.Theme.Selected}"/>
  <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource Sifra.Theme.TextPrimary}"/>
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource Sifra.Theme.TextPrimary}"/>
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource Sifra.Theme.TextPrimary}"/>
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource Sifra.Theme.Border}"/>

  <!--
    Generic ui:TextBlock foreground keys — a second, separate WPF-UI key
    family from Card/Button/TextControl above, discovered only by testing:
    plain ui:TextBlock elements (subtitles, error/success text) default to
    these rather than to CardForeground. Status colors (error/success) map
    to Sifra's brand status colors, not the window theme, since brand/
    status colors are defined as theme-independent per the identity
    package's own rule.
  -->
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource Sifra.Theme.TextPrimary}"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource Sifra.Theme.TextSecondary}"/>
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{DynamicResource Sifra.Theme.TextSecondary}"/>
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{DynamicResource Sifra.Status.Error}"/>
  <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{DynamicResource Sifra.Status.Success}"/>
  <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{DynamicResource Sifra.Status.Warning}"/>
</ResourceDictionary>

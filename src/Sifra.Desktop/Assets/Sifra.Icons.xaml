<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Geometry-only icon resources converted from the identity package's 24x24
    stroke SVGs (03_UI_Icons). Deliberately carry no Stroke/Fill here — the
    package's own guidance is that active nav uses Primary Blue and inactive
    nav uses Text Secondary, so color must be applied by the consumer per
    state, not baked into the icon.
  -->

  <!-- Navigation -->
  <GeometryGroup x:Key="Icon.Home">
    <PathGeometry Figures="M3 11.5 12 4l9 7.5 M5.5 10.5V20h13v-9.5 M9.5 20v-6h5v6"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Vault">
    <RectangleGeometry Rect="4,3.5,16,17" RadiusX="2.5" RadiusY="2.5"/>
    <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3"/>
    <PathGeometry Figures="M12 9v6M9 12h6"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Generator">
    <PathGeometry Figures="M14.5 4.5a5 5 0 1 0 5 5 M19.5 4.5v5h-5 M9.5 19.5a5 5 0 0 0 5-5 M4.5 19.5v-5h5"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Security">
    <PathGeometry Figures="M12 3 20 6v5c0 5-3.4 8.2-8 10-4.6-1.8-8-5-8-10V6l8-3Z M8.5 12 10.7 14.2 15.5 9.2"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Sync">
    <PathGeometry Figures="M20 7h-5V2 M19 7a8 8 0 0 0-13.5-2 M4 17h5v5 M5 17a8 8 0 0 0 13.5 2"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Sharing">
    <EllipseGeometry Center="8,8" RadiusX="3" RadiusY="3"/>
    <EllipseGeometry Center="17,7" RadiusX="2.5" RadiusY="2.5"/>
    <PathGeometry Figures="M2.5 20c.5-4 2.4-6 5.5-6s5 2 5.5 6 M14 14c3.8-.5 6.2 1.5 7 5"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Devices">
    <RectangleGeometry Rect="3,4,13,10" RadiusX="1.5" RadiusY="1.5"/>
    <PathGeometry Figures="M7 18h5M9.5 14v4"/>
    <RectangleGeometry Rect="17,8,4,9" RadiusX="1" RadiusY="1"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Settings">
    <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3"/>
    <PathGeometry Figures="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.4-2.4 1a8 8 0 0 0-1.7-1L14.5 3h-5l-.4 3.1a8 8 0 0 0-1.7 1l-2.4-1-2 3.4L5 11a7 7 0 0 0 0 2l-2 1.5 2 3.4 2.4-1a8 8 0 0 0 1.7 1l.4 3.1h5l.4-3.1a8 8 0 0 0 1.7-1l2.4 1 2-3.4-2-1.5a7 7 0 0 0 .1-1Z"/>
  </GeometryGroup>

  <!-- Actions -->
  <GeometryGroup x:Key="Icon.Plus">
    <PathGeometry Figures="M12 5v14M5 12h14"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Document">
    <PathGeometry Figures="M6 3h8l4 4v14H6z M14 3v5h5M9 12h6M9 16h6"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.More">
    <EllipseGeometry Center="5,12" RadiusX="1" RadiusY="1"/>
    <EllipseGeometry Center="12,12" RadiusX="1" RadiusY="1"/>
    <EllipseGeometry Center="19,12" RadiusX="1" RadiusY="1"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Copy">
    <RectangleGeometry Rect="8,8,11,11" RadiusX="2" RadiusY="2"/>
    <PathGeometry Figures="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>

    <EllipseGeometry Center="8,12" RadiusX="4" RadiusY="4"/>
    <PathGeometry Figures="m12 12 9-9M17 7l2 2M15 9l2 2"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Eye">
    <PathGeometry Figures="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/>
    <EllipseGeometry Center="12,12" RadiusX="2.5" RadiusY="2.5"/>
  </GeometryGroup>

  <GeometryGroup x:Key="Icon.Search">
    <EllipseGeometry Center="10.5,10.5" RadiusX="6.5" RadiusY="6.5"/>
    <PathGeometry Figures="m15.5 15.5 5 5"/>
  </GeometryGroup>

  <!-- Status -->

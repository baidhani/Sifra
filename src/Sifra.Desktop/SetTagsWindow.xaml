<ui:FluentWindow x:Class="Sifra.Desktop.SetTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Sifra.Desktop"
        mc:Ignorable="d"
        Title="Set Tags" Height="560" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        Background="{DynamicResource Sifra.WindowBrush}">
    <Grid Background="{DynamicResource Sifra.WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Set Tags" Background="{DynamicResource Sifra.WindowBrush}"
                     ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20">
            <ui:TextBlock Text="Tags" FontTypography="Subtitle" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource Sifra.CardBrush}" BorderBrush="{DynamicResource Sifra.BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Height="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl x:Name="TagsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TagCheckboxRow}">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,6" Foreground="{DynamicResource Sifra.TextPrimaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ui:TextBlock x:Name="EmptyStateText" Text="No tags yet. Use &quot;Add tag&quot; to create one."
                          FontTypography="Body" Foreground="{DynamicResource Sifra.TextSecondaryBrush}"
                          Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <ui:Button Content="Add tag" Icon="{ui:SymbolIcon Add24}" Margin="0,0,10,0" Click="OnAddTagClick"/>
            <ui:Button Content="OK" Appearance="Primary" Margin="0,0,10,0" Click="OnOkClick"/>
            <ui:Button Content="Cancel" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

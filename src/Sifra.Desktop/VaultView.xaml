<UserControl x:Class="Sifra.Desktop.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Sifra.Desktop"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Shared by the Label/Subtitle segment ItemsControls below — a
             transparent border that lights up amber only for the run of
             text that matched the current search query. Semi-transparent
             so it reads fine as an overlay on either theme without the
             segment needing its own theme-aware brush. -->
        <Style x:Key="SearchHighlightSegment" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                    <Setter Property="Background" Value="#66FFD54F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Collapsible sidebar section groups (Categories/Tags/Special) —
             a plain toggle, not ui:CardExpander's boxed-card look, which
             would be too heavy repeated three times in a narrow sidebar. -->
        <Style x:Key="SidebarSectionExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Padding="8,4" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Round chevron badge, left of the label — matches the
                                                     reference design instead of a bare right-aligned arrow. -->
                                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0"
                                                        Background="{DynamicResource Sifra.HoverBrush}">
                                                    <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronUp16" FontSize="11"
                                                                   Foreground="{DynamicResource Sifra.TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ui:TextBlock Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              FontTypography="BodyStrong" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="Symbol" Value="ChevronDown16"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpanderContent" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryItem" TargetType="RadioButton" BasedOn="{StaticResource Sifra.NavItem}">
            <Setter Property="GroupName" Value="VaultCategory"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <!-- Tighter than the shared Sifra.NavItem default — this list
                 can hold many tag entries, so a more compact row spacing
                 keeps more of them visible without scrolling. -->
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,1,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="AddCredentialButton" AutomationProperties.AutomationId="AddCredentialButton"
                           Content="Add" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,0,8,0" Click="OnAddCredentialClick"/>
                <ui:Button x:Name="EditCredentialButton" AutomationProperties.AutomationId="EditCredentialButton"
                           Content="Edit" Icon="{ui:SymbolIcon Edit24}" Margin="0,0,8,0" IsEnabled="False" Click="OnEditCredentialClick"/>
                <ui:Button x:Name="DeleteCredentialButton" AutomationProperties.AutomationId="DeleteCredentialButton"
                           Content="Delete" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,20,0" IsEnabled="False" Click="OnDeleteCredentialClick"/>
                <ui:Button x:Name="LockButton" AutomationProperties.AutomationId="LockButton"
                           Content="Lock" Icon="{ui:SymbolIcon LockClosed24}" Margin="0,0,8,0" Click="OnLockClick"/>
                <ui:Button x:Name="SyncButton" Content="Sync" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0" Click="OnSyncClick"/>
                <!-- Indeterminate, not determinate: SyncNow()/SyncBlobs() are single
                     blocking calls with no step-by-step progress to report, so a
                     filled percentage would just be fake. This only tells the user
                     "something is happening," which is what's actually true. -->
                <ui:ProgressRing x:Name="SyncProgressRing" IsIndeterminate="True" Width="16" Height="16"
                                 Margin="0,0,20,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                <ui:Button Content="Generator" Icon="{ui:SymbolIcon Key24}" Margin="0,0,8,0" Click="OnGeneratorClick"/>
                <ui:Button Content="Options" Icon="{ui:SymbolIcon Settings24}" Click="OnOptionsClick"/>
            </StackPanel>
        </Grid>

        <!-- Three-pane layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="195" MinWidth="140" MaxWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="480"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Category pane -->
            <Border Grid.Column="0" Background="{DynamicResource Sifra.CardBrush}" BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Sifra.Corner.Medium}">
                <DockPanel Margin="8">
                    <!-- Docked Bottom so it anchors to the bottom of the pane
                         instead of floating right under Tags, filling what
                         used to be dead space below a short tag list. -->
                    <Border x:Name="SyncStatusPanel" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="0,1,0,0" Padding="4,10,4,2" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CloudSync24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Sifra.TextSecondaryBrush}"/>
                                <ui:TextBlock x:Name="SyncPanelProviderText" FontTypography="Caption" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ui:ProgressRing x:Name="SyncPanelProgressRing" IsIndeterminate="True" Width="12" Height="12"
                                                 Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:TextBlock x:Name="SyncPanelStatusText" AutomationProperties.AutomationId="SyncStatusText"
                                          FontTypography="Caption" Foreground="{DynamicResource Sifra.TextSecondaryBrush}"
                                          Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Expander Header="Categories" IsExpanded="True" Style="{StaticResource SidebarSectionExpander}">
                    <StackPanel>
                    <RadioButton x:Name="AllItemsCategory" Style="{StaticResource CategoryItem}" Tag="All" Checked="OnCategoryChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="List24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="All Items" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock x:Name="AllItemsCategoryText" Grid.Column="2"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="FavoritesCategory" Style="{StaticResource CategoryItem}" Tag="Favorites" Checked="OnCategoryChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Star24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Favorites" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock x:Name="FavoritesCategoryText" Grid.Column="2"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="LockedCategory" Style="{StaticResource CategoryItem}" Tag="Locked" Checked="OnCategoryChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Locked" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LockedCategoryText" Grid.Column="2"/>
                        </Grid>
                    </RadioButton>
                    </StackPanel>
                    </Expander>

                    <Expander Header="Tags" IsExpanded="True" Style="{StaticResource SidebarSectionExpander}">
                        <StackPanel x:Name="TagCategoryPanel"/>
                    </Expander>

                    <Expander Header="Security" IsExpanded="True" Style="{StaticResource SidebarSectionExpander}">
                    <StackPanel>
                    <RadioButton x:Name="WeakCategory" Style="{StaticResource CategoryItem}" Tag="Weak" Checked="OnCategoryChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ShieldQuestion24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#F5A623"/>
                            <TextBlock Grid.Column="1" Text="Weak Passwords" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock x:Name="WeakCategoryText" Grid.Column="2"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="ReusedCategory" Style="{StaticResource CategoryItem}" Tag="Reused" Checked="OnCategoryChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowRepeatAll24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#9B59B6"/>
                            <TextBlock Grid.Column="1" Text="Reused Passwords" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ReusedCategoryText" Grid.Column="2"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="CompromisedCategory" Style="{StaticResource CategoryItem}" Tag="Compromised" Checked="OnCategoryChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ShieldError24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#E5484D"/>
                            <TextBlock Grid.Column="1" Text="Compromised" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CompromisedCategoryText" Grid.Column="2"/>
                        </Grid>
                    </RadioButton>
                    </StackPanel>
                    </Expander>

                    <Expander Header="Special" IsExpanded="True" Style="{StaticResource SidebarSectionExpander}">
                    <StackPanel>
                    <RadioButton x:Name="ArchivedCategory" Style="{StaticResource CategoryItem}" Tag="Archived" Checked="OnCategoryChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Archive24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#E8A33D"/>
                            <TextBlock Grid.Column="1" Text="Archived" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ArchivedCategoryText" Grid.Column="2"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="TrashCategory" Style="{StaticResource CategoryItem}" Tag="Trash" Checked="OnCategoryChanged">
                        <RadioButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Empty trash bin..." Click="OnEmptyTrashClick"/>
                            </ContextMenu>
                        </RadioButton.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Delete24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Trash" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TrashCategoryText" Grid.Column="2"/>
                        </Grid>
                    </RadioButton>
                    </StackPanel>
                    </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

            <!-- List pane -->
            <Border Grid.Column="2" Background="{DynamicResource Sifra.CardBrush}" BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Sifra.Corner.Medium}">
                <DockPanel>
                    <!-- Lives here rather than in the top toolbar — it
                         searches these cards specifically (label, fields,
                         tags), so it belongs next to what it filters. -->
                    <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="10,10,10,6"
                                PlaceholderText="Search your vault..." TextChanged="OnSearchTextChanged"/>

                    <!-- Only shown while viewing Trash, and only when at
                         least one item has been sitting there 30+ days —
                         a nudge, not an automatic purge (nothing here ever
                         deletes anything on its own). -->
                    <Border x:Name="StaleTrashNoticeBorder" DockPanel.Dock="Top" Visibility="Collapsed"
                            Background="{DynamicResource Sifra.HoverBrush}" CornerRadius="6" Margin="10,0,10,6" Padding="10,8">
                        <StackPanel>
                            <ui:TextBlock x:Name="StaleTrashNoticeText" FontTypography="Caption" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ui:Button Content="Empty trash bin..." Click="OnEmptyTrashClick"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="CredentialsList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged"
                         MouseDoubleClick="OnCredentialsListDoubleClick" ContextMenuOpening="OnCredentialContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="CredentialContextMenu">
                            <MenuItem x:Name="ContextEditItem" Header="Edit" Click="OnContextEditClick"/>
                            <MenuItem x:Name="ContextSetTagsItem" Header="Set Tags..." Click="OnContextSetTagsClick"/>
                            <MenuItem x:Name="ContextFavoriteItem" Click="OnContextToggleFavoriteClick"/>
                            <Separator x:Name="ContextSeparator1"/>
                            <MenuItem x:Name="ContextArchiveItem" Click="OnContextToggleArchiveClick"/>
                            <MenuItem x:Name="ContextLockItem" Header="Lock" Click="OnContextLockClick"/>
                            <MenuItem x:Name="ContextRemoveLockItem" Header="Remove Lock..." Click="OnContextRemoveLockClick"/>
                            <MenuItem x:Name="ContextDeleteItem" Header="Delete" Click="OnContextDeleteClick"/>
                            <MenuItem x:Name="ContextRestoreItem" Header="Restore" Click="OnContextRestoreClick"/>
                            <MenuItem x:Name="ContextDeletePermanentlyItem" Header="Delete permanently..." Click="OnContextDeletePermanentlyClick"/>
                            <MenuItem x:Name="ContextUnlockItem" Header="Unlock..." Click="OnContextUnlockClick"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Sifra.BorderBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Sifra.SelectedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Sifra.HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{Binding AvatarBackground}" Margin="0,0,10,0" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding InitialLetter}" Visibility="{Binding AvatarLetterVisibility}"
                                                   Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="{Binding AvatarSymbol}" Filled="True" Visibility="{Binding AvatarSymbolVisibility}"
                                                       FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding AvatarImage}" Visibility="{Binding AvatarImageVisibility}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding LabelSegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SearchHighlightSegment}">
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Sifra.TextPrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding SubtitleSegments}" Visibility="{Binding SubtitleVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SearchHighlightSegment}">
                                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Sifra.TextSecondaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Compact, comma-separated icon+name per tag — a comma reads
                                         naturally for a list of like items (unlike a "|" divider,
                                         which suits separating unlike sections) and stays light
                                         next to the colored icons. -->
                                    <ItemsControl ItemsSource="{Binding TagChips}" Visibility="{Binding TagsVisibility}" Margin="0,1,0,0" AlternationCount="1000">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:TagChipViewModel}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Separator" Text=", " FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Sifra.TextSecondaryBrush}"/>
                                                    <ui:SymbolIcon Symbol="Tag24" Filled="True" FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{Binding ColorBrush}" Margin="0,0,2,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Sifra.TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                        <Setter TargetName="Separator" Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ui:SymbolIcon Grid.Column="2" Symbol="{Binding LockSymbol}" Visibility="{Binding LockVisibility}"
                                               Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ui:SymbolIcon Grid.Column="3" Symbol="Star24" Visibility="{Binding FavoriteVisibility}"
                                               Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

            <!-- Detail pane -->
            <Border x:Name="DetailHost" Grid.Column="4" Background="{DynamicResource Sifra.CardBrush}" BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Sifra.Corner.Medium}"/>
        </Grid>
    </Grid>
</UserControl>

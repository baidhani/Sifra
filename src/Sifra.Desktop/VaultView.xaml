<UserControl x:Class="Sifra.Desktop.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Sifra.Desktop"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="CategoryItem" TargetType="RadioButton" BasedOn="{StaticResource Sifra.NavItem}">
            <Setter Property="GroupName" Value="VaultCategory"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button x:Name="AddCredentialButton" AutomationProperties.AutomationId="AddCredentialButton"
                           Content="Add" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,0,8,0" Click="OnAddCredentialClick"/>
                <ui:Button x:Name="EditCredentialButton" AutomationProperties.AutomationId="EditCredentialButton"
                           Content="Edit" Icon="{ui:SymbolIcon Edit24}" Margin="0,0,8,0" IsEnabled="False" Click="OnEditCredentialClick"/>
                <ui:Button x:Name="DeleteCredentialButton" AutomationProperties.AutomationId="DeleteCredentialButton"
                           Content="Delete" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,20,0" IsEnabled="False" Click="OnDeleteCredentialClick"/>
                <ui:Button x:Name="LockButton" AutomationProperties.AutomationId="LockButton"
                           Content="Lock" Icon="{ui:SymbolIcon LockClosed24}" Margin="0,0,8,0" Click="OnLockClick"/>
                <ui:Button Content="Sync" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0" Click="OnPlaceholderToolClick" Tag="Sync"/>
                <ui:Button Content="Generator" Icon="{ui:SymbolIcon Key24}" Margin="0,0,8,0" Click="OnPlaceholderToolClick" Tag="Generator"/>
                <ui:Button Content="Options" Icon="{ui:SymbolIcon Settings24}" Click="OnPlaceholderToolClick" Tag="Settings"/>
            </StackPanel>

            <ui:TextBox x:Name="SearchBox" Grid.Column="1" Width="220" MinWidth="140" Margin="20,0,0,0"
                        PlaceholderText="Search your vault..." TextChanged="OnSearchTextChanged"/>
        </Grid>

        <!-- Three-pane layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" MinWidth="140" MaxWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="480"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Category pane -->
            <Border Grid.Column="0" Background="{DynamicResource Sifra.CardBrush}" BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Sifra.Corner.Medium}">
                <StackPanel Margin="8">
                    <RadioButton x:Name="AllItemsCategory" Style="{StaticResource CategoryItem}" Tag="All" Checked="OnCategoryChanged">
                        <TextBlock x:Name="AllItemsCategoryText" Text="All Items"/>
                    </RadioButton>
                    <RadioButton x:Name="FavoritesCategory" Style="{StaticResource CategoryItem}" Tag="Favorites" Checked="OnCategoryChanged">
                        <TextBlock x:Name="FavoritesCategoryText" Text="Favorites"/>
                    </RadioButton>
                    <RadioButton x:Name="WeakCategory" Style="{StaticResource CategoryItem}" Tag="Weak" Checked="OnCategoryChanged">
                        <TextBlock x:Name="WeakCategoryText" Text="Weak Passwords"/>
                    </RadioButton>
                    <RadioButton x:Name="ReusedCategory" Style="{StaticResource CategoryItem}" Tag="Reused" Checked="OnCategoryChanged">
                        <TextBlock x:Name="ReusedCategoryText" Text="Reused Passwords"/>
                    </RadioButton>
                    <RadioButton x:Name="CompromisedCategory" Style="{StaticResource CategoryItem}" Tag="Compromised" Checked="OnCategoryChanged">
                        <TextBlock x:Name="CompromisedCategoryText" Text="Compromised"/>
                    </RadioButton>
                    <ui:TextBlock Text="Labels" FontTypography="Caption" Foreground="{DynamicResource Sifra.TextSecondaryBrush}" Margin="8,16,0,4"/>
                    <StackPanel x:Name="LabelCategoryPanel"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

            <!-- List pane -->
            <Border Grid.Column="2" Background="{DynamicResource Sifra.CardBrush}" BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Sifra.Corner.Medium}">
                <ListBox x:Name="CredentialsList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged"
                         MouseDoubleClick="OnCredentialsListDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Sifra.BorderBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Sifra.SelectedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Sifra.HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Sifra.Brand.PrimaryBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Sifra.TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Username}" FontSize="11" Foreground="{DynamicResource Sifra.TextSecondaryBrush}"/>
                                </StackPanel>

                                <ui:SymbolIcon Grid.Column="2" Symbol="Star24" Visibility="{Binding FavoriteVisibility}"
                                               Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

            <!-- Detail pane -->
            <Border x:Name="DetailHost" Grid.Column="4" Background="{DynamicResource Sifra.CardBrush}" BorderBrush="{DynamicResource Sifra.BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Sifra.Corner.Medium}"/>
        </Grid>
    </Grid>
</UserControl>

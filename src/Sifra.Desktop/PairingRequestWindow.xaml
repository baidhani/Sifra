<ui:FluentWindow x:Class="Sifra.Desktop.PairingRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Pairing Request" Height="240" Width="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Topmost="True"
        Background="{DynamicResource Sifra.WindowBrush}">
    <Grid Background="{DynamicResource Sifra.WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Pairing Request" Background="{DynamicResource Sifra.WindowBrush}"
                     ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20" VerticalAlignment="Center">
            <ui:TextBlock Text="A browser extension wants to connect" FontTypography="BodyStrong" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <ui:TextBlock x:Name="BrowserNameText" FontTypography="Subtitle" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <ui:TextBlock Text="If you didn't just click &quot;Pair with Desktop&quot; in a browser extension, click Deny."
                          FontTypography="Caption" Foreground="{DynamicResource Sifra.TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <ui:Button Content="Approve" Appearance="Primary" Margin="0,0,10,0" Click="OnApproveClick"/>
            <ui:Button Content="Deny" Click="OnDenyClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

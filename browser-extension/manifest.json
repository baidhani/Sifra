{
  "manifest_version": 3,
  "name": "Sifra Password Vault (dev)",
  "version": "1.0.0",
  "description": "STORY-010 walking skeleton: offers and fills credentials from a local Sifra vault, only with explicit consent.",
  "permissions": ["nativeMessaging", "activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sifra Vault"
  },
  "key": ""
}
